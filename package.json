{
  "name": "woolgather",
  "private": true,
  "version": "2.1.1",
  "description": "Herd the flock home before nightfall. A sheepdog game built with Vite, TypeScript and Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/build-assets.mjs",
    "playtest": "node tests/playtest.mjs",
    "film": "node tests/film.mjs",
    "media": "node tests/make-media.mjs",
    "site": "node tools/build-site.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
